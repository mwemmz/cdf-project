// FundPath — Prisma schema
// Docs: https://www.prisma.io/docs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  APPLICANT
  ADVISOR
  ADMIN
}

enum BookingStatus {
  PENDING
  PAID
  CANCELLED
}

// Pipeline: Submitted -> Under Review -> Approved/Rejected -> Disbursed -> Repaying -> Closed
enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  DISBURSED
  REPAYING
  CLOSED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(APPLICANT)
  createdAt    DateTime @default(now())

  advisorProfile      AdvisorProfile?
  businessPlans       BusinessPlan[]
  plansAsAdvisor      BusinessPlan[]  @relation("PlansAsAdvisor")
  applications        Application[]
  bookingsAsApplicant Booking[]       @relation("BookingsAsApplicant")
  bookingsAsAdvisor   Booking[]       @relation("BookingsAsAdvisor")
  products            Product[]
  messagesSent        Message[]
  notifications       Notification[]

  @@map("users")
}

// ---------------------------------------------------------------------------
// Marketplace: advisors
// ---------------------------------------------------------------------------

model AdvisorProfile {
  id              String  @id @default(cuid())
  userId          String  @unique
  specialty       String
  bio             String
  pricePerSession Float
  verified        Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("advisor_profiles")
}

// ---------------------------------------------------------------------------
// CDF opportunities
// ---------------------------------------------------------------------------

model Opportunity {
  id               String   @id @default(cuid())
  constituencyName String
  category         String
  amountAvailable  Float
  deadline         DateTime

  businessPlans BusinessPlan[]
  applications  Application[]

  @@index([category])
  @@map("opportunities")
}

// ---------------------------------------------------------------------------
// Business plans & feasibility
// ---------------------------------------------------------------------------

model BusinessPlan {
  id                String   @id @default(cuid())
  applicantId       String
  opportunityId     String
  advisorId         String?
  businessIdea      String
  targetMarket      String
  startupCosts      Float
  revenueProjection Float
  amountRequested   Float
  createdAt         DateTime @default(now())

  applicant        User              @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  opportunity      Opportunity       @relation(fields: [opportunityId], references: [id])
  advisor          User?             @relation("PlansAsAdvisor", fields: [advisorId], references: [id], onDelete: SetNull)
  feasibilityScore FeasibilityScore?
  application      Application?

  @@index([applicantId])
  @@index([advisorId])
  @@map("business_plans")
}

model FeasibilityScore {
  id              String   @id @default(cuid())
  businessPlanId  String   @unique
  score           Int
  category        String
  recommendations String
  createdAt       DateTime @default(now())

  businessPlan BusinessPlan @relation(fields: [businessPlanId], references: [id], onDelete: Cascade)

  @@map("feasibility_scores")
}

// ---------------------------------------------------------------------------
// Marketplace: bookings
// ---------------------------------------------------------------------------

// applicantId and advisorId both reference User; the advisor user must have role ADVISOR.
model Booking {
  id          String        @id @default(cuid())
  applicantId String
  advisorId   String
  status      BookingStatus @default(PENDING)
  price       Float
  note        String?
  createdAt   DateTime      @default(now())

  applicant User @relation("BookingsAsApplicant", fields: [applicantId], references: [id], onDelete: Cascade)
  advisor   User @relation("BookingsAsAdvisor", fields: [advisorId], references: [id])

  messages Message[]
  review   Review?

  @@map("bookings")
}

// ---------------------------------------------------------------------------
// Applications, loans & repayments
// ---------------------------------------------------------------------------

model Application {
  id               String            @id @default(cuid())
  applicantId      String
  opportunityId    String
  businessPlanId   String            @unique
  status           ApplicationStatus @default(SUBMITTED)
  amountDisbursed  Float?
  disbursedAt      DateTime?
  repaymentDueDate DateTime?
  createdAt        DateTime          @default(now())

  applicant    User         @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  opportunity  Opportunity  @relation(fields: [opportunityId], references: [id])
  businessPlan BusinessPlan @relation(fields: [businessPlanId], references: [id])
  repayments   Repayment[]

  @@index([applicantId])
  @@index([status])
  @@map("applications")
}

model Repayment {
  id            String   @id @default(cuid())
  applicationId String
  amount        Float
  date          DateTime
  note          String?
  createdAt     DateTime @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@map("repayments")
}

// ---------------------------------------------------------------------------
// Storefront
// ---------------------------------------------------------------------------

model Product {
  id          String  @id @default(cuid())
  applicantId String
  name        String
  description String
  price       Float
  // Plain text URL only — no file upload handling (intentional to save time)
  imageUrl    String?

  applicant User @relation(fields: [applicantId], references: [id], onDelete: Cascade)

  @@index([applicantId])
  @@map("products")
}

// ---------------------------------------------------------------------------
// Ecosystem: chat, reviews, notifications, resources
// ---------------------------------------------------------------------------

// Chat thread tied to a booking. Unlocked once the booking status is PAID.
model Message {
  id        String   @id @default(cuid())
  bookingId String
  senderId  String
  content   String
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender  User    @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([bookingId, createdAt])
  @@map("messages")
}

// One review per booking, left by the applicant after the session is paid.
model Review {
  id          String   @id @default(cuid())
  bookingId   String   @unique
  applicantId String
  advisorId   String
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([advisorId])
  @@map("reviews")
}

enum NotificationType {
  FEASIBILITY_READY
  NEW_MESSAGE
  REPAYMENT_DUE
  APPLICATION_STATUS
  NEW_REVIEW
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

model Resource {
  id        String   @id @default(cuid())
  title     String
  category  String
  content   String
  createdAt DateTime @default(now())

  @@index([category])
  @@map("resources")
}
