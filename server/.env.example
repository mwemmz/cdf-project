# FundPath Server environment variables
# Copy this file to .env and fill in real values.

# PostgreSQL connection string (Neon in production)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@host:5432/fundpath?sslmode=require"

# Secret used to sign JWTs — use a long random string
JWT_SECRET="change-me-to-a-long-random-string"

# Port the Express server listens on
PORT=4000

# Public URL of the client (used for CORS during development)
CLIENT_URL="http://localhost:5173"