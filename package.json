{
  "name": "fundpath",
  "version": "1.0.0",
  "private": true,
  "description": "FundPath — CDF loan-to-repayment platform (monorepo)",
  "packageManager": "pnpm@10.33.2",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "dev:server": "pnpm --filter fundpath-server dev",
    "dev:client": "pnpm --filter fundpath-client dev",
    "seed": "pnpm --filter fundpath-server seed",
    "migrate:deploy": "pnpm --filter fundpath-server prisma:migrate",
    "prisma:generate": "pnpm --filter fundpath-server prisma:generate",
    "test": "pnpm --filter fundpath-server test"
  }
}